# HostGator FTPS — PLACEHOLDER (não preencher com credenciais reais neste repo)

HG_FTP_SERVER=ftp.example.acucaradasencomendas.com.br
HG_FTP_USER=deploy-lp@acucaradasencomendas.com.br
HG_FTP_PASSWORD=REPLACE_ME_IN_LOCAL_ENV_ONLY
HG_PROTOCOL=ftps
HG_FTP_PORT=21

# Caminho remoto — terminar com /
HG_SERVER_DIR=/public_html/lp/CAMPAIGN_SLUG/

# Campanha ativa (referência local)
CAMPAIGN_SLUG=exemplo-campanha-2026

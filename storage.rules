rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /delivery_drivers/{userId}/{allPaths=**} {
      allow read, delete: if request.auth != null
                          && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource != null
                            && request.resource.size > 0
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*|application/pdf');
    }

    match /stores/{ownerId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == ownerId
                   && request.resource != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /perfil/{userId}/{fileName} {
      allow read: if true;
      allow write, delete: if request.auth != null
                           && request.auth.uid == userId;
    }

    match /profile_pictures/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && fileName.matches('^' + request.auth.uid + '_.*')
                            && request.resource != null
                            && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && fileName.matches('^' + request.auth.uid + '_.*');
    }

    match /product_images/{userId}/{fileName} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /store_assets/{producerId}/{fileName} {
      allow read: if true;
      allow create, update, delete: if false;
    }
  }
}